; Epic 36 (AD-41): candidates never import skills (CandidateSkillsChanged event instead); the skills graph
; never imports matching or search (they sit above it).
[importlinter:contract:p3-candidates-not-skills]
name = p3-candidates-not-skills: candidates never import skills (event CandidateSkillsChanged instead)
type = forbidden
source_modules =
    app.services.candidates
forbidden_modules =
    app.services.skills
    app.services.skills_service

; Second half of the AD-41 rule, a separate contract because candidates legitimately reach matching / search.
[importlinter:contract:p3-skills-not-matching]
name = p3-candidates-not-skills (skills part): the skills graph never imports matching or search
type = forbidden
; Epic 37: direct imports only -- skills legitimately imports candidates / ai, which reach matching transitively
; (candidates -> pipeline -> matching). matching / search reach the graph through core.skill_graph_port.
allow_indirect_imports = True
source_modules =
    app.services.skills
forbidden_modules =
    app.services.matching
    app.services.search

; Epic 49 (AD-47, NFR-38): protected self-ID data is unreachable from every other module. Only the fairness package,
; its three routers, its task module and its erasure handler may import app.models.fairness / app.services.fairness
; (hooks.py is loaded by core.hooks.autodiscover -- a dynamic import). app.core.fairness (P1 queue fairness) is
; unrelated and not banned. tests/modules/fairness/test_isolation.py runs this contract against a probe import.
[importlinter:contract:fairness-isolation]
name = fairness-isolation: only the fairness package, its routers, task and erasure handler import the fairness models / services (AD-47, NFR-38)
type = forbidden
allow_indirect_imports = True
source_modules =
    app.api
    app.cli
    app.constants
    app.main
    app.core
    app.dependencies
    app.events
    app.job
    app.models.*
    app.router
    app.schemas
    app.services.*
    app.tasks
forbidden_modules =
    app.models.fairness
    app.services.fairness
ignore_imports =
    app.services.fairness.** -> app.models.fairness
    app.services.fairness.** -> app.services.fairness.**
    app.services.fairness_erasure -> app.models.fairness
    app.services.fairness_erasure -> app.services.fairness.**
    app.router.fairness -> app.models.fairness
    app.router.fairness -> app.services.fairness.**
    app.router.portal_self_id -> app.models.fairness
    app.router.portal_self_id -> app.services.fairness.**
    app.router.fairness_public -> app.models.fairness
    app.router.fairness_public -> app.services.fairness.**
    app.tasks.fairness -> app.services.fairness.**
    ; Epic 65 (spec A6): the AEDT glue reads the public P4 readers (aedt_p4) and the AlternativeRequested event only.
    app.services.ai_governance.** -> app.services.fairness.aedt_p4
    app.services.ai_governance.** -> app.services.fairness.events

; Epic 52 (FR-257, spec A2): AI, the workflow engine and analytics never import a module that defines a Phase 3
; human-only (★) transition / decision guard (tests/governance/test_p3_human_only.py maps them).
[importlinter:contract:fr257-human-only]
