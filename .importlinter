; Epic 36 (AD-40): Phase 3 domain dependency order, top to bottom. Owners add their facade
; (``campaigns_service``, ``campus_service``, ...) to their package's layer when it lands.
[importlinter:contract:p3-dag]
name = p3-dag: Phase 3 domains import only downwards (AD-40)
type = layers
containers =
    app.services
layers =
    fairness | analytics
    ; Epic 41: the mobility facade sits directly above its package (a facade cannot be an independent sibling).
    ; Epic 39: the campaigns facade likewise sits directly above its package (sibling of mobility_service).
    ; Epic 44: the workforce facade likewise (sibling of mobility_service / campaigns_service).
    ; Epic 43: the campus facade likewise.
    mobility_service | campaigns_service | workforce_service | campus_service
    campaigns | campus | workforce | mobility
    pools_service
    talent_pools
    segments_service
    segments
    assessments_service | projects_service | referrals | immigration_service
    assessments | projects | immigration
    skills_service
    skills

; Epic 36 (AD-40): core and the Phase 1 / Phase 2 domains never import a Phase 3 package or facade. matching,
; search and reporting are deliberately not sources (they sit above skills / read everything). Cross-direction
; needs go through events or registries.
[importlinter:contract:p3-p1p2-below]
name = p3-p1p2-below: core, Phase 1 and Phase 2 never import a Phase 3 domain
