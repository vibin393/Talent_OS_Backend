; ================================================================ Phase 5 (Epic 66, AD-74, spec 0.16)
; Phase 5 dependency order, top to bottom. Owners fill the placeholder packages; : siblings may import each other
; (the foundation facades), | siblings are independent. public_events and ecosystem / vault sit lower so the
; connector runtime can register its outbox sink and every P5 package can check suspension and read secrets.
[importlinter:contract:p5-dag]
name = p5-dag: Phase 5 packages import only downwards (AD-74)
type = layers
containers =
    app.services
layers =
    mcp_server | portal_copilot | developer_portal | job_network | webhooks_service | campaign_copy | public_api_service
    public_api | mcp_store
    webhooks
    marketplace_service
    marketplace
    telephony_service
    telephony
    hrms_sync_service | ledger_sync_service
    job_distribution | hrms_sync | ledger_sync | calendar_sync
    integrations_service : oauth_service : metering_service : sandbox_service : exposure_service
    integrations | oauth | metering | sandbox | exposure
    public_events_service
    public_events
    ecosystem_service : vault_service
    ecosystem | vault
; Registration-only edges: hooks register notification types (the notifications registry reaches comms ->
; connections -> vault_service indirectly) and the relay kick enqueues its Celery task.
ignore_imports =
    app.services.ecosystem.hooks -> app.services.notifications_service
    app.services.oauth.hooks -> app.services.notifications_service
    app.services.public_events.dispatch -> app.tasks.public_events
    app.services.public_api.hooks -> app.tasks.public_api
    app.services.webhooks.common -> app.tasks.webhooks
    app.services.webhooks.hooks -> app.tasks.webhooks
    app.services.webhooks.replay -> app.tasks.webhooks

; Core, the shared infrastructure and every P1-P4 package never import a Phase 5 package (reverse needs use events,
; the outbox sinks or registries). Two listed exceptions: vault-backed connector configs and the connector job gate.
[importlinter:contract:p5-below]
name = p5-below: core and Phase 1-4 code never import a Phase 5 package
type = forbidden
allow_indirect_imports = True
