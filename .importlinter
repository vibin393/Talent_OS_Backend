; Epic 13 (AD-32): Phase 2 domain dependency order, top to bottom. Each domain's facade module
; (``<domain>_service``) sits directly above its package (import-linter cannot mix independent and
; non-independent siblings in one layer). Each epic adds its package + facade to its layer; packages that do not
; exist yet are omitted until they land.
[importlinter]
root_packages =
    app
include_external_packages = False

[importlinter:contract:p2-dag]
name = p2-dag: Phase 2 domains import only downwards (AD-32)
type = layers
containers =
    app.services
layers =
    ; Epic 35: go-live import orchestrator sits at the top (calls the owner domains' import functions).
    golive
    ; Epic 15: crm sits above commercials and the P1 core domains (AD-32 edge crm --> P1CORE); nothing imports it.
    crm_service
    crm
    receivables_service
    receivables
    billing_service | payroll_service
    billing | payroll
    postings
    time_service | expenses_service
    time | expenses
    ; Epic 23: onboarding (events to compliance / bgv only; calls placements and documents).
    onboarding
    compliance_service
    ; Epic 21: compliance (events to placements only, AD-25; never imports bgv / onboarding / time).
    compliance
    ; Epic 20: bgv registers its start gate with placements and reads commercials; compliance never imports it.
    bgv
    placements_service
    placements
    vendors_service
    vendors
    commercials_service
    commercials
    ; Epic 33: SMS / WhatsApp messaging (uses the connector ports below).
    messaging_service
    messaging
    ; Epic 50 (AD-48): client SSO opens tos_client sessions through external_auth (signin / access), so sso sits
    ; directly above it; external_auth reaches sso only through the gate sso.hooks registers.
    sso_service
    sso
    legal_entities_service | documents_service | external_auth_service | connectors_service
    legal_entities | documents | external_auth
    ; Epic 22: provider connectors sit below the domains that resolve providers through them (AD-29).
    connectors
; Epic 16: source domains register their posting-source loaders with the ledger (AD-23 says so) although
; ``postings`` sits above them; only the registration module may reach up.
ignore_imports =
    app.services.commercials.hooks -> app.services.postings
    ; Epic 25: the time loaders (posting_source, registered from hooks) build postings SourceItem DTOs.
    app.services.time.posting_source -> app.services.postings
    ; Epic 27: the expense_line loader (posting_source, registered from hooks) builds SourceItem DTOs.
    app.services.expenses.posting_source -> app.services.postings

[importlinter:contract:p1-infra-below-p2]
name = p1-infra-below-p2: core and Phase 1 infrastructure never import a Phase 2 domain
type = forbidden
source_modules =
    app.core
    app.services.approvals
    app.services.workflow
    app.services.sla
    app.services.notifications_service
    app.services.activity_service
    app.services.comms
    app.services.privacy
    app.services.files_service
forbidden_modules =
    app.services.crm
    app.services.crm_service
    app.services.legal_entities
    app.services.legal_entities_service
    app.services.documents
    app.services.documents_service
    app.services.external_auth
    app.services.external_auth_service
    app.services.connectors
    app.services.connectors_service
    app.services.commercials
    app.services.commercials_service
    app.services.vendors
    app.services.vendors_service
    app.services.placements
    app.services.placements_service
    app.services.compliance_service
    app.services.compliance
    app.services.time
    app.services.time_service
    app.services.expenses
    app.services.expenses_service
    app.services.postings
    app.services.billing
    app.services.billing_service
    app.services.payroll
    app.services.payroll_service
    app.services.receivables
    app.services.receivables_service
    app.services.messaging
    app.services.messaging_service
    app.services.bgv

[importlinter:contract:core-below-services]
name = p1-infra-below-p2 (core part): app.core never imports app.services
type = forbidden
source_modules =
    app.core
forbidden_modules =
    app.services

; Epic 35 (FR-181, spec A4): AI and the workflow engine never import a module that defines a Phase 2 human-only
; transition / decision guard (tests/governance/test_human_only_p2.py maps them). app.services.approvals
; (``decide``) is excluded: the workflow executor legitimately imports it (EscalationSpec); decide refuses
; non-approver ActorRef kinds itself.
