; Phase 5 connector adapters see only core.integrations, core.net_safety, core.signing, DTOs and their own package.
[importlinter:contract:p5-connectors-isolation]
name = p5-connectors-isolation: Phase 5 adapters never import models, the DB layer or domain services
type = forbidden
allow_indirect_imports = True
source_modules =
    app.services.connectors.job_board
    app.services.connectors.hrms
    app.services.connectors.stt
    app.services.connectors.voice.bridge
    app.services.connectors.voice.live_base
