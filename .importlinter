    app.services.connectors.accounting.tally_xml
    app.services.connectors.accounting.manifests
forbidden_modules =
    app.models
    app.core.database
    app.services.candidates
    app.services.demands
    app.services.pipeline
    app.services.placements
    app.services.billing
    app.services.integrations
    app.services.integrations_service
    app.services.vault
    app.services.vault_service

; The Public API surface calls domain facades only.
[importlinter:contract:p5-public-api-surface]
name = p5-public-api-surface: public_v1 routers never import models (no direct SQL: facades only)
type = forbidden
allow_indirect_imports = True
source_modules =
    app.router.public_v1
forbidden_modules =
    app.models

; The MCP server reaches tools only through the agent runtime facade.
[importlinter:contract:p5-mcp-via-runtime]
name = p5-mcp-via-runtime: the MCP server never imports tools, runtime internals, models or P1-P4 domains
type = forbidden
source_modules =
    app.services.mcp_server
forbidden_modules =
    app.services.agent_tools
    app.services.agent_runtime
    app.models
    app.services.candidates
    app.services.demands
    app.services.pipeline
    app.services.interviews
    app.services.offers
    app.services.placements
; Epic 73: the registration-only hook edge into the facade (which implements ``mcp_server.ports.McpBackend``).
ignore_imports =
    app.services.mcp_server.hooks -> app.services.mcp_service

; Job Network models are reachable only from the job_network package and its routers (Epic 75 adds them).
[importlinter:contract:p5-network-platform]
name = p5-network-platform: only the job network package imports its platform models
type = forbidden
allow_indirect_imports = True
source_modules =
    app.services.candidates
    app.services.demands
    app.services.pipeline
    app.services.integrations
    app.services.marketplace
forbidden_modules =
    app.models.job_network

; Epic 75 (A4, binding): the Job Network never reads or dedupes Candidate data -- no candidate data crosses tenants.
[importlinter:contract:p5-network-no-candidates]
name = p5-network-no-candidates: the job network imports nothing from candidates / pipeline / matching / search
type = forbidden
allow_indirect_imports = True
source_modules =
    app.services.job_network
forbidden_modules =
    app.services.candidates
    app.services.pipeline
    app.services.matching
    app.services.search

